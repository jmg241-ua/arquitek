{
  "name": "Certificacion PDF a Excel",
  "nodes": [
    {
      "id": "wh",
      "name": "Recibir PDF",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cert-080640",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "cert-080640"
    },
    {
      "id": "prep",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary || {};\nconst keys = Object.keys(binary);\nconst key = keys[0] || 'data';\nconst b = binary[key];\nconst binaryId = b && b.id ? b.id : 'N/A';\nconst proxyUrl = 'http://arquitek-proxy:3456/cert?binaryId=' + encodeURIComponent(binaryId);\nreturn [{ binaryId: binaryId, proxyUrl: proxyUrl }];"
      }
    },
    {
      "id": "http",
      "name": "Proxy → DeepSeek + Excel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.proxyUrl }}",
        "authentication": "none",
        "options": {
          "timeout": 120000
        }
      }
    }
  ],
  "connections": {
    "Recibir PDF": {
      "main": [
        [
          {
            "node": "Preparar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar": {
      "main": [
        [
          {
            "node": "Proxy → DeepSeek + Excel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}